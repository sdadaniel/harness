{
  "name": "hsync",
  "displayName": "HSync",
  "description": "Sync skills, agents, commands, and AGENTS.md from .harness/ to Cursor, Claude Code, and Codex",
  "version": "0.1.0",
  "publisher": "sdadaniel",
  "repository": {
    "type": "git",
    "url": "https://github.com/sdadaniel/harness.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "hSync.initProject",
        "title": "Init .harness in Project",
        "category": "HSync",
        "icon": "$(new-folder)"
      },
      {
        "command": "hSync.showPanel",
        "title": "Show Panel",
        "category": "HSync",
        "icon": "$(layout-sidebar-left)"
      },
      {
        "command": "hSync.sync",
        "title": "Sync Skills & Agents",
        "category": "HSync",
        "icon": "$(sync)"
      },
      {
        "command": "hSync.refresh",
        "title": "Refresh",
        "category": "HSync",
        "icon": "$(refresh)"
      },
      {
        "command": "hSync.openItem",
        "title": "Open",
        "category": "HSync"
      },
      {
        "command": "hSync.toggleTarget",
        "title": "Toggle Platform",
        "category": "HSync"
      },
      {
        "command": "hSync.openSettingsTab",
        "title": "Open Settings Tab",
        "category": "HSync",
        "icon": "$(open-preview)"
      },
      {
        "command": "hSync.openDocs",
        "title": "Open Documentation",
        "category": "HSync",
        "icon": "$(book)"
      }
    ],
    "configuration": {
      "title": "HSync",
      "properties": {
        "hSync.harnessRoot": {
          "type": "string",
          "default": "",
          "description": "Project root containing .harness/. Empty = workspace folder."
        },
        "hSync.projectRoot": {
          "type": "string",
          "default": "",
          "description": "Project root for installs. Empty = first workspace folder."
        },
        "hSync.scope": {
          "type": "string",
          "enum": [
            "project",
            "user"
          ],
          "default": "project",
          "description": "Install skills/agents in the project or user home directory."
        },
        "hSync.targets.cursor": {
          "type": "boolean",
          "default": true,
          "description": "Sync to Cursor (.cursor/skills, .cursor/agents)."
        },
        "hSync.targets.claude": {
          "type": "boolean",
          "default": true,
          "description": "Sync to Claude Code (.claude/skills, .claude/agents)."
        },
        "hSync.targets.codex": {
          "type": "boolean",
          "default": true,
          "description": "Sync to Codex (.agents/skills, .codex/agents)."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "hSync",
          "title": "HSync",
          "icon": "media/harness.svg"
        }
      ]
    },
    "views": {
      "hSync": [
        {
          "id": "hSync.settings",
          "name": "Settings",
          "type": "webview"
        },
        {
          "id": "hSync.registrations",
          "name": "Installations"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "hSync.registrations",
        "contents": "Each project defines skills/agents in `.harness/`.\n[Init .harness](command:hSync.initProject)\n[Sync Now](command:hSync.sync)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "hSync.openSettingsTab",
          "when": "view == hSync.settings",
          "group": "navigation@1"
        },
        {
          "command": "hSync.openDocs",
          "when": "view == hSync.settings",
          "group": "navigation@2"
        },
        {
          "command": "hSync.sync",
          "when": "view == hSync.registrations",
          "group": "navigation@1"
        },
        {
          "command": "hSync.refresh",
          "when": "view == hSync.registrations",
          "group": "navigation@2"
        }
      ]
    }
  },
  "scripts": {
    "bundle-script": "rm -rf bundled && mkdir -p bundled/script && cp scripts/sync.sh bundled/script/ && chmod +x bundled/script/sync.sh",
    "vscode:prepublish": "npm run bundle-script && npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run bundle-script && vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.1",
    "typescript": "^5.3.3"
  }
}
